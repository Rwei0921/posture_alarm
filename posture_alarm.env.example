# Copy this file to /etc/posture_alarm.env on Raspberry Pi and fill real values.
# Do not commit the filled production file.

LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=
DISCORD_WEBHOOK_URL=

BUZZER_GPIO_PIN=17
LED_GPIO_PIN=27
LED_2_ENABLED=1
LED_2_GPIO_PIN=22
DHT22_ENABLED=1
DHT22_DATA_PIN=4
DHT22_USE_PULSEIO=0
DHT22_READ_INTERVAL_SECONDS=2.0
DHT22_LOG_INTERVAL_SECONDS=60.0
DHT22_SHOW=1

LOG_FILE_ENABLED=1
LOG_FILE_PATH=/home/pi/posture_alarm/data/posture_alarm.log

SIMULATE_GPIO=0
BUZZER_PWM_ENABLED=1
BUZZER_PWM_FREQUENCY=2000
